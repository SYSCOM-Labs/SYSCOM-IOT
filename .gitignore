# Dependencias (cualquier subproyecto)
node_modules/
**/node_modules/

# Build frontend
dist/
dist-ssr/
build/
**/dist/
**/dist-ssr/
**/build/
*.tsbuildinfo

# Entorno (no subir secretos)
.env
.env.*
!.env.example
!**/.env.example
.dev.vars

# Config local OpenRouter / Anthropic (secretos solo en .env o copia local)
**/server/OPENROUTER/settings.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# SQLite y datos locales
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
**/server/data/*.db
**/server/data/*.db-shm
**/server/data/*.db-wal
**/server/data/backups/
*.bak

# Caché de herramientas
.vite/
.cache/
.eslintcache
*.local
.turbo

# Tests / cobertura
coverage/
.nyc_output/

# SO
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
