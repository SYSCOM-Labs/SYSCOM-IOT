# Copia a .env en esta carpeta. No subas .env a git.
# Clave de OpenRouter (Bearer). Rota la clave si alguna vez quedó en un commit.
ANTHROPIC_AUTH_TOKEN=

# Opcional (valores por defecto del ejemplo)
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_API_KEY=qwen/qwen3-coder:free

# Tras editar .env, genera settings.json para herramientas que lean ese JSON:
#   npm run openrouter:sync
# (desde la carpeta LoraWan-Monitoreo-y-Control)
