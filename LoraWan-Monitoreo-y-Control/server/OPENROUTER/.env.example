# Copia a .env en esta carpeta (o exporta en tu shell). No subas .env a git.
# Clave de OpenRouter (Bearer). Rota la clave si alguna vez quedó en un commit.
ANTHROPIC_AUTH_TOKEN=

# Opcional: mismo valor que en settings.example.json si tu herramienta lo lee por separado
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_API_KEY=qwen/qwen3-coder:free
