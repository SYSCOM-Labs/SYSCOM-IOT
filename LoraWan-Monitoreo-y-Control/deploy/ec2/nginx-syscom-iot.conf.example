# Ejemplo Nginx: proxy hacia Syscom IoT (Node en 127.0.0.1:3001).
# Copiar a /etc/nginx/conf.d/syscom-iot.conf, cambiar server_name y (opcional) certificados TLS.
#
# sudo nginx -t && sudo systemctl reload nginx
#
# Tras certbot --nginx suele crearse el bloque :443 automáticamente; mantened las mismas
# location /api/events/stream, /api/ y / para SSE y SPA.

upstream syscom_iot_node {
    server 127.0.0.1:3001;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name iot.ejemplo.com;

    location /api/events/stream {
        proxy_pass http://syscom_iot_node;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
    }

    location /api/ {
        proxy_pass http://syscom_iot_node;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        client_max_body_size 25m;
    }

    location / {
        proxy_pass http://syscom_iot_node;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
